# Gemini API Key (구글 AI 에이전트 연동용)
GEMINI_API_KEY=your_gemini_api_key_here

# 한국투자증권 API 설정 (모의투자 및 실전투자용)
# KIS: Korea Investment & Securities
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_CANO=your_account_number_here  # 종합계좌번호 (8자리)
KIS_ACNT_PRDT_CD=01               # 계좌상품코드 (보통 01)
KIS_URL=https://openapivts.koreainvestment.com:29443  # 모의투자용 URL (실전투자는 https://openapi.koreainvestment.com:9443)

# 구글 스프레드시트 보안 연동 설정
GOOGLE_SHEET_CREDENTIALS_PATH=path_to_your_service_account_credentials.json  # 서비스 계정 인증키 파일 경로
GOOGLE_SHEET_KEY=your_spreadsheet_key_here                                 # 구글 스프레드시트 고유 키값

# KRX(한국거래소) 정보데이터시스템 Open API 인증키
# 발급/서비스 신청: https://data.krx.co.kr → 로그인 → 'OpenAPI' 메뉴 (서비스별 개별 신청 필요)
KRX_OPENAPI_SECRET_KEY=your_krx_openapi_key_here

# 한국은행 경제통계시스템(ECOS) Open API 인증키
# 발급: https://ecos.bok.or.kr/api/#/ → 오픈API 인증키 신청
ECOS_OPENAPI_KEY=your_ecos_openapi_key_here

# 미국 세인트루이스 연방은행(FRED) API 키 — src/data/fred_provider.py
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# 금융감독원 OpenDART 인증키 — src/data/dart_provider.py (국내 공시·재무제표)
# 발급: https://opendart.fss.or.kr → 인증키 신청/관리
DART_API_KEY=your_dart_api_key_here

# SEC EDGAR 접속용 User-Agent — src/data/sec_edgar_provider.py
# SEC 공정 접근 정책상 "이름 이메일" 형식의 연락처가 필요하다(공시 원문·티커 목록 조회 시). 예: Hong Gildong hong@example.com
SEC_USER_AGENT=your_name your_email@example.com
